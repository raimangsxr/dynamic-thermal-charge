# Copy to /etc/dynamic-thermal-charge/environment with mode 0600.
# Never commit real credentials. This file is the only place a secret lives:
# neither the connection string nor the API key is ever written to the database,
# to the repository, or to the logs.

# Where the configuration lives. Required; the service will not start without it.
#
# Local database on the device itself (the default for a Raspberry Pi):
DTC_DATABASE_URL=sqlite:////var/lib/dynamic-thermal-charge/dynamic-thermal-charge.db
#
# Remote PostgreSQL. Always external to the device: installing a database engine
# on a Raspberry Pi 2B is ruled out by its resources. The driver is pg8000, the
# only one installable on ARMv7 without a compiler; install it with the
# "postgres" extra.
#DTC_DATABASE_URL=postgresql+pg8000://dtc:PASSWORD@database.example.lan:5432/dtc

# AEMET OpenData key. The configuration stores only the NAME of this variable.
AEMET_API_KEY=

# --------------------------------------------------------------------------- #
# HTTP API (the dynamic-thermal-charge-api service)
# --------------------------------------------------------------------------- #

# Shared credential for the API. REQUIRED for the API service; the controller
# does not need it. Generate one with:
#
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#
# At least 32 characters. The API refuses to start if this is empty, too short or
# still an example value, so it can never end up listening unprotected.
#
# Treat it like the password to the electrical panel, because functionally it is:
# whoever holds it can change the maximum power and the pin assignments.
DTC_API_TOKEN=

# Listen address. The default, 127.0.0.1, is reachable only from this device.
# Setting 0.0.0.0 exposes the API to your network, where it serves IN CLEAR TEXT:
# anyone on that network can read the token in transit. Reasonable on a trusted
# home network; NOT reasonable on the internet without a reverse proxy with TLS.
#DTC_API_HOST=0.0.0.0
#DTC_API_PORT=8420

# How old the controller's heartbeat may be before the API stops presenting the
# output state as current. Derived from the controller's own polling cadence when
# unset; only override it if you know why.
#DTC_API_STALE_SECONDS=30

# Origins allowed to call the API from a browser. Empty means none: a
# cross-origin client only works when you name it here on purpose.
#DTC_API_CORS_ORIGINS=http://panel.lan:4200

# Relay test sessions are short-lived capabilities. GET polling is 1 second;
# only the visible owning tab renews its lease every 5 seconds.
#DTC_RELAY_TEST_LEASE_SECONDS=30
#DTC_RELAY_TEST_STATE_POLL_SECONDS=1
#DTC_RELAY_TEST_LEASE_RENEW_SECONDS=5

# --------------------------------------------------------------------------- #
# Home Assistant MQTT (the independent MQTT publisher service)
# --------------------------------------------------------------------------- #

# Broker address is required only by the MQTT service. A loopback address may
# be the local end of an SSH/VPN tunnel to a remote Home Assistant host.
DTC_MQTT_HOST=
# Plain local MQTT normally uses 1883. For broker TLS use 8883 and enable TLS.
#DTC_MQTT_PORT=1883
#DTC_MQTT_TLS=false

# Optional broker credential. Keep the password empty in this example and set
# it only in the installed mode-0600 environment file; it is never stored in DB.
DTC_MQTT_USERNAME=
DTC_MQTT_PASSWORD=

# Home Assistant observes homeassistant by default. Changing DTC_MQTT_PREFIX
# moves transport topics but does not change entity unique_ids.
#DTC_MQTT_PREFIX=dtc
#DTC_MQTT_DISCOVERY_PREFIX=homeassistant
#DTC_MQTT_PUBLISH_SECONDS=15
