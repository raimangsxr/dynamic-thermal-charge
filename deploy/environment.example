# DEPRECATED: compatibility reference for `dtc db import-legacy` only.
# systemd units never source this file. Configure values in /configuracion-sistema.
# It intentionally contains no usable credentials.
DTC_DATABASE_URL=sqlite:///var/lib/dynamic-thermal-charge/dynamic-thermal-charge.db
# postgresql+pg8000://usuario:PASSWORD@servidor:5432/dtc (migration reference)
AEMET_API_KEY=
DTC_API_TOKEN=
DTC_API_HOST=127.0.0.1
DTC_API_PORT=8080
DTC_API_CORS_ORIGINS=
DTC_MQTT_HOST=
DTC_MQTT_PORT=1883
DTC_MQTT_USERNAME=
DTC_MQTT_PASSWORD=
DTC_MQTT_TLS=false
DTC_MQTT_PREFIX=dtc
DTC_MQTT_DISCOVERY_PREFIX=homeassistant
DTC_MQTT_PUBLISH_SECONDS=15

# The API is clear text unless TLS is terminated by the reverse proxy; 0.0.0.0
# is intentionally not a default. Protect any externally exposed deployment.
# File permissions for this historical example: 0600.
