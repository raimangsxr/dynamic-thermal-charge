[Unit]
Description=Dynamic Thermal Charge controller
Documentation=https://github.com/raimangsxr/dynamic-thermal-charge
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=dynamic-thermal-charge
Group=dynamic-thermal-charge
WorkingDirectory=/var/lib/dynamic-thermal-charge
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Runtime configuration is resolved from bootstrap.db and the canonical store.
ExecStartPre=/opt/dynamic-thermal-charge/venv/bin/dynamic-thermal-charge run --check-config
ExecStart=/opt/dynamic-thermal-charge/venv/bin/dynamic-thermal-charge run --controller
Restart=on-failure
RestartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Holds bootstrap.db, fallback.db and (when selected) the SQLite canonical stores.
ReadWritePaths=/var/lib/dynamic-thermal-charge

[Install]
WantedBy=multi-user.target
