[Unit]
Description=Dynamic Thermal Charge controller
Documentation=https://github.com/raimangsxr/dynamic-thermal-charge
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=dynamic-thermal-charge
Group=dynamic-thermal-charge
WorkingDirectory=/var/lib/dynamic-thermal-charge
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/dynamic-thermal-charge/environment
# Configuration comes from DTC_DATABASE_URL, set in the environment file above.
# There is no configuration file argument any more.
ExecStartPre=/opt/dynamic-thermal-charge/venv/bin/dynamic-thermal-charge run --check-config
ExecStart=/opt/dynamic-thermal-charge/venv/bin/dynamic-thermal-charge run --controller
Restart=on-failure
RestartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Holds the local SQLite database and its WAL sidecars, plus the active plan cache.
ReadWritePaths=/var/lib/dynamic-thermal-charge

[Install]
WantedBy=multi-user.target
