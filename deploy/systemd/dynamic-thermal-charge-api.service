[Unit]
Description=Dynamic Thermal Charge HTTP API
Documentation=https://github.com/raimangsxr/dynamic-thermal-charge
# Deliberately NOT Requires= or After= the controller: the two services are
# independent by design. The API answers with or without it, reporting its
# absence, and stopping the API cannot affect the relays.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dynamic-thermal-charge
Group=dynamic-thermal-charge
WorkingDirectory=/var/lib/dynamic-thermal-charge
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/dynamic-thermal-charge/environment
# Configuration comes from DTC_DATABASE_URL and the API settings come from
# DTC_API_* , both in the environment file above.
ExecStart=/opt/dynamic-thermal-charge/venv/bin/dynamic-thermal-charge api
# Importing the web stack takes seconds on a Raspberry Pi 2B, and the first boot
# after an update is slower still. No ExecStartPre: it would pay that cost twice.
TimeoutStartSec=120s
Restart=on-failure
RestartSec=15s
TimeoutStopSec=15s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Never the gpio group: this service must not be able to reach the hardware.
# Holds the local SQLite database and its WAL sidecars.
ReadWritePaths=/var/lib/dynamic-thermal-charge

[Install]
WantedBy=multi-user.target
